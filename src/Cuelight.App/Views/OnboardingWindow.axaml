<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Cuelight.App.ViewModels"
        x:Class="Cuelight.App.Views.OnboardingWindow"
        x:DataType="vm:KeyEntryViewModel"
        Title="Cuelight"
        Icon="avares://Cuelight/Assets/app.png"
        Width="520" Height="780" CanResize="False"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="PreferSystemChrome"
        ExtendClientAreaTitleBarHeightHint="-1">
  <Grid>
    <!-- Scrolls when the screen is too short for it (a 768-pixel laptop at 150% scaling). The same space
         above and below keeps the content centred; the strip at the top is the window's drag area. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="52,54,52,54" Spacing="0" VerticalAlignment="Center">

      <Border Width="64" Height="64" CornerRadius="20" Background="{DynamicResource AccentSoft}" HorizontalAlignment="Left">
        <Path Data="{StaticResource IconCue}" Stroke="{DynamicResource Accent}" StrokeThickness="2.4" StrokeLineCap="Round" Width="30" Height="30" Stretch="Uniform" />
      </Border>

      <TextBlock Classes="display" Text="Cuelight" Margin="0,28,0,0" />
      <TextBlock Classes="muted" TextWrapping="Wrap" LineHeight="23" FontSize="15" Margin="0,10,0,0"
                 Text="Hears what your PC is playing, reads any text you point at, and tells you what to say or type, in words that sound like you." />

      <TextBlock Text="Choose your AI" FontWeight="SemiBold" Margin="0,34,0,8" />
      <StackPanel Spacing="8" Background="Transparent"
                  ToolTip.Tip="Whose AI writes the suggestions: Claude (Anthropic), ChatGPT (OpenAI), Gemini (Google), Grok (xAI), or any other service that speaks the OpenAI chat API. You can change this later in Settings.">
        <ListBox Classes="segmented" ItemsSource="{x:Static vm:KeyEntryViewModel.ProviderItems}" SelectedIndex="{Binding ProviderIndex}" />
        <TextBlock Classes="muted small" TextWrapping="Wrap" Text="{Binding Info.Blurb}" />
      </StackPanel>

      <StackPanel Spacing="6" Margin="0,18,0,0" Background="Transparent" IsVisible="{Binding ShowAddress}"
                  ToolTip.Tip="The address of the service and the model to use, as the service's documentation gives them. For example https://openrouter.ai/api/v1, https://api.groq.com/openai/v1, or http://localhost:11434/v1 for Ollama on this PC.">
        <TextBlock Text="Service address" FontWeight="SemiBold" />
        <TextBox Classes="field" Text="{Binding BaseUrl}" Watermark="https://openrouter.ai/api/v1" FontSize="14" Padding="12,10" />
        <TextBlock Text="Model name" FontWeight="SemiBold" Margin="0,8,0,0" />
        <TextBox Classes="field" Text="{Binding ModelId}" Watermark="e.g. llama3.2" FontSize="14" Padding="12,10" />
      </StackPanel>

      <TextBlock Text="{Binding KeyLabel}" FontWeight="SemiBold" Margin="0,24,0,8" />
      <Grid>
        <TextBox x:Name="KeyBox" Classes="field" Text="{Binding Key}" PasswordChar="{Binding PasswordChar}" Watermark="{Binding KeyHint}" FontSize="14" Padding="12,10,46,10"
                 ToolTip.Tip="{Binding KeyTip}" />
        <Button Classes="icon" Command="{Binding ToggleRevealCommand}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"
                ToolTip.Tip="Show or hide the key" AutomationProperties.Name="Show or hide the key">
          <Path Data="{StaticResource IconEye}" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round" Width="18" Height="18" Stretch="Uniform" />
        </Button>
      </Grid>
      <TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" Margin="2,10,0,0" />

      <Button Classes="primary" Command="{Binding SubmitCommand}" HorizontalAlignment="Stretch" Margin="0,22,0,0" FontSize="14"
              ToolTip.Tip="{Binding ContinueTip}">
        <TextBlock Text="{Binding IsBusy, Converter={x:Static vm:Converters.ContinueLabel}}" Foreground="{Binding $parent[Button].Foreground}" />
      </Button>

      <Button Classes="ghost" Content="{Binding GetKeyLabel}" Click="OnGetKey" HorizontalAlignment="Left" Margin="-10,10,0,0"
              IsVisible="{Binding HasKeyPage}" ToolTip.Tip="{Binding GetKeyTip}" />

      <TextBlock Classes="faint small" TextWrapping="Wrap" LineHeight="18" Margin="0,26,0,0"
                 Text="{Binding PrivacyText}" />
      <TextBlock Classes="faint small" TextWrapping="Wrap" LineHeight="18" Margin="0,10,0,0"
                 Text="{Binding BillingText}" />
    </StackPanel>
    </ScrollViewer>
    <Grid x:Name="Header" Height="54" VerticalAlignment="Top" Background="Transparent" />
  </Grid>
</Window>
