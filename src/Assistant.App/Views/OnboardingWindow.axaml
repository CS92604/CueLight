<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Assistant.App.ViewModels"
        x:Class="Assistant.App.Views.OnboardingWindow"
        x:DataType="vm:KeyEntryViewModel"
        Title="Claude Live Assistant"
        Icon="avares://ClaudeLiveAssistant/Assets/app.png"
        Width="520" Height="640" CanResize="False"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="PreferSystemChrome"
        ExtendClientAreaTitleBarHeightHint="-1">
  <Grid RowDefinitions="54,*">
    <Grid x:Name="Header" Background="Transparent" />
    <StackPanel Grid.Row="1" Margin="52,8,52,40" Spacing="0" VerticalAlignment="Center">

      <Border Width="64" Height="64" CornerRadius="20" Background="{DynamicResource AccentSoft}" HorizontalAlignment="Left">
        <Path Data="{StaticResource IconBurst}" Stroke="{DynamicResource Accent}" StrokeThickness="2.4" StrokeLineCap="Round" Width="30" Height="30" Stretch="Uniform" />
      </Border>

      <TextBlock Classes="display" Text="Live Assistant" Margin="0,28,0,0" />
      <TextBlock Classes="muted" TextWrapping="Wrap" LineHeight="23" FontSize="15" Margin="0,10,0,0"
                 Text="Hears what your PC is playing, reads any text you point at, and tells you what to say or type, in words that sound like you." />

      <TextBlock Text="Claude API key" FontWeight="SemiBold" Margin="0,38,0,8" />
      <Grid ColumnDefinitions="*,Auto">
        <TextBox x:Name="KeyBox" Classes="field" Text="{Binding Key}" PasswordChar="{Binding PasswordChar}" Watermark="sk-ant-…" FontSize="14" />
        <Button Grid.Column="1" Classes="icon" Command="{Binding ToggleRevealCommand}" Margin="6,0,0,0" ToolTip.Tip="Show or hide the key">
          <Path Data="{StaticResource IconEye}" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round" Width="18" Height="18" Stretch="Uniform" />
        </Button>
      </Grid>
      <TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" Margin="2,10,0,0" />

      <Button Classes="primary" Command="{Binding SubmitCommand}" HorizontalAlignment="Stretch" Margin="0,22,0,0" FontSize="14">
        <TextBlock Text="{Binding IsBusy, Converter={x:Static vm:Converters.ContinueLabel}}" Foreground="White" />
      </Button>

      <Button Classes="ghost" Content="Get a key at console.anthropic.com" Click="OnGetKey" HorizontalAlignment="Left" Margin="-10,10,0,0" />

      <TextBlock Classes="faint small" TextWrapping="Wrap" LineHeight="18" Margin="0,26,0,0"
                 Text="Your key is stored encrypted on this PC and is only ever sent to Anthropic. Speech is turned into text on your PC; only text, and the text area you choose, is sent to Claude." />
    </StackPanel>
  </Grid>
</Window>
