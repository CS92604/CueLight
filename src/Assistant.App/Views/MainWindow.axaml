<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Assistant.App.ViewModels"
        x:Class="Assistant.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Claude Live Assistant"
        Icon="avares://ClaudeLiveAssistant/Assets/app.png"
        Width="440" Height="780" MinWidth="420" MinHeight="560"
        Topmost="{Binding PinOnTop}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="PreferSystemChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        ToolTip.ShowOnDisabled="True"
        WindowStartupLocation="Manual">
  <DockPanel>

    <!-- Header -->
    <Grid x:Name="Header" DockPanel.Dock="Top" Height="54" Margin="22,0,0,0" ColumnDefinitions="*,Auto,Auto,150" Background="Transparent">
      <!-- The title gives way (with "…") rather than run under the buttons when the window is very narrow. -->
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalAlignment="Center" IsHitTestVisible="False">
        <Path Data="{StaticResource IconBurst}" Stroke="{DynamicResource Accent}" StrokeThickness="2.6" StrokeLineCap="Round" Width="20" Height="20" Stretch="Uniform" />
        <TextBlock Grid.Column="1" Classes="title" Text="Live Assistant" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      </Grid>
      <ToggleButton Grid.Column="1" Classes="icon" IsChecked="{Binding PinOnTop}" VerticalAlignment="Center"
                    AutomationProperties.Name="Keep on top"
                    ToolTip.Tip="Keep on top. When on, this window stays above your other windows, so you can glance at it during a call.">
        <Path Data="{StaticResource IconPin}" Stroke="{Binding $parent[ToggleButton].Foreground}" StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round" Width="17" Height="17" Stretch="Uniform" />
      </ToggleButton>
      <Button Grid.Column="2" Classes="icon" Command="{Binding OpenSettingsCommand}" VerticalAlignment="Center" Margin="2,0,0,0"
              AutomationProperties.Name="Settings"
              ToolTip.Tip="Settings. Change how replies sound, which Claude model is used, privacy options and speech recognition.">
        <Path Data="{StaticResource IconSliders}" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round" Width="17" Height="17" Stretch="Uniform" />
      </Button>
    </Grid>

    <!-- Switches -->
    <Grid DockPanel.Dock="Top" Margin="18,0,18,10" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
      <ToggleButton Classes="pill rec" IsChecked="{Binding IsRecording}"
                    ToolTip.Tip="Recording. On: listens to your speakers (and your microphone, if you turned that on in Settings) and, when Type is on, watches the text area. Off: nothing is heard, watched or sent to Claude.">
        <StackPanel Orientation="Horizontal" Spacing="7">
          <Ellipse Classes="pilldot" Width="8" Height="8" VerticalAlignment="Center" />
          <TextBlock Text="Recording" Foreground="{Binding $parent[ToggleButton].Foreground}" />
          <TextBlock Text="{Binding IsRecording, Converter={x:Static vm:Converters.OnOff}}" FontWeight="Bold" Foreground="{Binding $parent[ToggleButton].Foreground}" />
        </StackPanel>
      </ToggleButton>
      <ToggleButton Grid.Column="1" Classes="pill" IsChecked="{Binding TypeEnabled}"
                    ToolTip.Tip="Type. On: also reads a text area you pick (a chat, email or document) and suggests what to type there. Off: only listens to the conversation and suggests what to say.">
        <StackPanel Orientation="Horizontal" Spacing="7">
          <Path Data="{StaticResource IconScan}" Stroke="{Binding $parent[ToggleButton].Foreground}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" Width="13" Height="13" Stretch="Uniform" />
          <TextBlock Text="Type" Foreground="{Binding $parent[ToggleButton].Foreground}" />
          <TextBlock Text="{Binding TypeEnabled, Converter={x:Static vm:Converters.OnOff}}" FontWeight="Bold" Foreground="{Binding $parent[ToggleButton].Foreground}" />
        </StackPanel>
      </ToggleButton>
    </Grid>

    <!-- Composer -->
    <Border DockPanel.Dock="Bottom" Padding="18,8,18,14" Background="{DynamicResource Bg}">
      <StackPanel Spacing="8">
        <Border Classes="card composer" Padding="14,5,6,5" CornerRadius="22" BoxShadow="0 2 14 0 #14000000" IsEnabled="{Binding IsRecording}"
                ToolTip.Tip="Optional direction for Claude, like “shorter” or “more formal”. Press Enter to get suggestions with it, or Regenerate to redo the current ones.">
          <Grid ColumnDefinitions="*,Auto">
            <TextBox Classes="bare" Text="{Binding Hint}" Watermark="Ask for a different angle, e.g. “shorter”" VerticalAlignment="Center">
              <TextBox.KeyBindings>
                <KeyBinding Gesture="Enter" Command="{Binding SuggestCommand}" />
              </TextBox.KeyBindings>
            </TextBox>
            <Button Grid.Column="1" Classes="send" Command="{Binding SuggestCommand}" ToolTip.Tip="{Binding SendTip}" AutomationProperties.Name="Get suggestions now">
              <Path Data="{StaticResource IconSend}" Stroke="White" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" Width="16" Height="16" Stretch="Uniform" />
            </Button>
          </Grid>
        </Border>
        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
          <ToggleSwitch IsChecked="{Binding AutoSuggest}" OnContent="Auto-suggest" OffContent="Auto-suggest" FontSize="12"
                        ToolTip.Tip="Auto-suggest. On: Claude suggests a reply by itself whenever someone speaks or the text area changes. Off: it only answers when you press Send or Panic." />
          <Button Grid.Column="2" Classes="panic" Command="{Binding PanicCommand}" VerticalAlignment="Center"
                  IsVisible="{Binding TypeEnabled}" IsEnabled="{Binding IsRecording}"
                  ToolTip.Tip="{Binding PanicTip}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Path Data="{StaticResource IconBolt}" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" Width="14" Height="14" Stretch="Uniform" />
              <TextBlock Text="Panic" Foreground="{Binding $parent[Button].Foreground}" />
            </StackPanel>
          </Button>
          <Button Grid.Column="3" Classes="ghost" Content="Clear chat" Command="{Binding ClearChatCommand}" Margin="4,0,-6,0" VerticalAlignment="Center"
                  ToolTip.Tip="Clear chat. Forgets the conversation so far, including what Claude has been shown, and clears the suggestions. Use it when a new call starts." />
        </Grid>
      </StackPanel>
    </Border>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="18,0,18,16" Spacing="14">

        <!-- Status -->
        <StackPanel Spacing="8" Margin="4,0,4,0">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Ellipse Classes="dot" Classes.listening="{Binding IsListening}" Classes.busy="{Binding IsThinking}" Classes.error="{Binding IsError}" VerticalAlignment="Top" Margin="0,5,9,0" />
            <TextBlock Grid.Column="1" Text="{Binding StatusLine}" Classes="muted" TextWrapping="Wrap" VerticalAlignment="Center" LineHeight="18" />
            <Button Grid.Column="2" Classes="ghost" Content="Retry" Command="{Binding RetrySpeechCommand}" IsVisible="{Binding RetryVisible}" Padding="10,3" Margin="9,0,-10,0" VerticalAlignment="Center"
                    ToolTip.Tip="Try setting up speech recognition again." />
          </Grid>
          <ProgressBar Classes="thin" Value="{Binding Progress}" Minimum="0" Maximum="100" IsVisible="{Binding ProgressVisible}" />
        </StackPanel>

        <!-- Conversation -->
        <Border Classes="card">
          <StackPanel Spacing="10">
            <TextBlock Classes="eyebrow" Text="CONVERSATION" />
            <TextBlock IsVisible="{Binding !HasTurns}" Classes="muted" TextWrapping="Wrap" LineHeight="20"
                       Text="Nothing yet. Whatever your speakers play shows up here, transcribed on this PC." />
            <ScrollViewer x:Name="TranscriptScroll" MaxHeight="156" IsVisible="{Binding HasTurns}" VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding Turns}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:TurnVm">
                    <Grid ColumnDefinitions="46,*" Margin="0,0,0,7">
                      <TextBlock Text="{Binding Who}" Classes="who small" Classes.me="{Binding IsMe}" FontWeight="SemiBold" Margin="0,1,0,0" />
                      <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" LineHeight="20" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </StackPanel>
        </Border>

        <!-- Text area -->
        <Border Classes="card" Padding="14,12" IsVisible="{Binding TypeEnabled}">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
            <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource SurfaceAlt}" VerticalAlignment="Center">
              <Path Data="{StaticResource IconScan}" Stroke="{DynamicResource TextMuted}" StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round" Width="18" Height="18" Stretch="Uniform" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
              <TextBlock Text="Text area to watch" FontWeight="SemiBold" />
              <TextBlock Text="{Binding RegionText}" Classes="muted small" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
              <Button Classes="secondary" Content="{Binding HasRegion, Converter={x:Static vm:Converters.SelectLabel}}" Command="{Binding SelectRegionCommand}"
                      ToolTip.Tip="Drag a box over the exact part of the screen to watch: a chat, an email or a document. Claude only ever sees what is inside the box." />
              <Button Classes="icon" Command="{Binding ClearRegionCommand}" IsVisible="{Binding HasRegion}"
                      AutomationProperties.Name="Stop watching this area"
                      ToolTip.Tip="Stop watching this area. Type stays on; pick a new area whenever you like.">
                <Path Data="{StaticResource IconClose}" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.75" StrokeLineCap="Round" Width="14" Height="14" Stretch="Uniform" />
              </Button>
            </StackPanel>
          </Grid>
        </Border>

        <!-- Suggestions -->
        <StackPanel Spacing="12">
          <Grid ColumnDefinitions="*,Auto" Margin="4,4,0,0">
            <TextBlock Classes="eyebrow" Text="SUGGESTIONS" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="ghost" Command="{Binding RegenerateCommand}" IsVisible="{Binding HasSections}" IsEnabled="{Binding IsRecording}" Margin="0,0,-6,0"
                    ToolTip.Tip="{Binding RegenerateTip}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Path Data="{StaticResource IconRefresh}" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.9" StrokeLineCap="Round" StrokeJoin="Round" Width="13" Height="13" Stretch="Uniform" />
                <TextBlock Text="Regenerate" Foreground="{Binding $parent[Button].Foreground}" />
              </StackPanel>
            </Button>
          </Grid>
          <Border IsVisible="{Binding !HasSections}" Padding="4,6">
            <TextBlock Classes="title muted" FontStyle="Italic" FontSize="19" TextWrapping="Wrap" LineHeight="28" Foreground="{DynamicResource TextFaint}"
                       Text="{Binding EmptyHint}" />
          </Border>
          <ItemsControl ItemsSource="{Binding Sections}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:SectionVm">
                <StackPanel Spacing="8" Margin="0,0,0,12">
                  <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsChip}" Margin="4,0,0,0">
                    <Border Classes="chip say" IsVisible="{Binding IsSay}" ToolTip.Tip="SAY: something to say out loud in the conversation."><TextBlock Text="SAY" /></Border>
                    <Border Classes="chip type" IsVisible="{Binding IsType}" ToolTip.Tip="TYPE: a reply to type or paste into the text area you selected."><TextBlock Text="TYPE" /></Border>
                    <TextBlock Text="{Binding Hint}" Classes="faint small" VerticalAlignment="Center" />
                  </StackPanel>
                  <TextBlock IsVisible="{Binding IsNote}" Text="{Binding NoteText}" Classes="reply muted" TextWrapping="Wrap" Margin="4,0" />
                  <ItemsControl ItemsSource="{Binding Options}" IsVisible="{Binding !IsNote}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:OptionVm">
                        <Border Classes="option">
                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBlock Classes="reply" Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Classes="ghost" Classes.done="{Binding JustCopied}" Content="{Binding CopyLabel}"
                                    Command="{Binding CopyCommand}" IsEnabled="{Binding IsComplete}" VerticalAlignment="Top" Margin="0,-3,-6,0"
                                    ToolTip.Tip="Copy this suggestion to the clipboard, ready to paste." />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
