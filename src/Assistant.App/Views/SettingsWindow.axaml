<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Assistant.App.ViewModels"
        xmlns:core="using:Assistant.Core"
        x:Class="Assistant.App.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="Settings"
        Icon="avares://ClaudeLiveAssistant/Assets/app.png"
        Width="480" Height="760" MinWidth="420" MinHeight="520"
        ToolTip.ShowOnDisabled="True"
        WindowStartupLocation="CenterOwner"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="PreferSystemChrome"
        ExtendClientAreaTitleBarHeightHint="-1">
  <DockPanel>
    <Grid x:Name="Header" DockPanel.Dock="Top" Height="54" Margin="22,0,0,0" Background="Transparent">
      <TextBlock Classes="title" Text="Settings" VerticalAlignment="Center" IsHitTestVisible="False" />
    </Grid>

    <Border DockPanel.Dock="Bottom" Padding="22,12,22,16" Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Classes="faint small" Text="Changes are saved as you make them." VerticalAlignment="Center" />
        <Button Grid.Column="1" Classes="primary" Content="Done" Click="OnDone" Padding="22,9" />
      </Grid>
    </Border>

    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="22,4,22,28" Spacing="22">

        <!-- API key -->
        <StackPanel Spacing="10">
          <TextBlock Classes="eyebrow" Text="CLAUDE API KEY" />
          <Border Classes="card">
            <StackPanel Spacing="12">
              <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding !IsEditingKey}">
                <TextBlock Text="{Binding MaskedKey}" FontFamily="Consolas, 'Cascadia Mono', Menlo, monospace" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                  <Button Classes="secondary" Content="Change" Command="{Binding ChangeKeyCommand}" Padding="12,6"
                          ToolTip.Tip="Replace the saved key with a different one." />
                  <!-- A text button: its words line up with the card's inset on the right, as the key does on the left. -->
                  <Button Classes="ghost" Content="Remove" Command="{Binding RemoveKeyCommand}" IsVisible="{Binding HasKey}" Margin="0,0,-10,0"
                          ToolTip.Tip="Remove the saved key from this PC. You will be asked for a key again." />
                </StackPanel>
              </Grid>
              <StackPanel Spacing="10" IsVisible="{Binding IsEditingKey}">
                <Grid>
                  <TextBox Classes="field" Text="{Binding KeyEntry.Key}" PasswordChar="{Binding KeyEntry.PasswordChar}" Watermark="sk-ant-…" Padding="12,10,44,10"
                           ToolTip.Tip="Your Claude API key, from console.anthropic.com. It is stored encrypted on this PC and only ever sent to Anthropic." />
                  <Button Classes="icon" Command="{Binding KeyEntry.ToggleRevealCommand}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"
                          AutomationProperties.Name="Show or hide the key" ToolTip.Tip="Show or hide the key">
                    <Path Data="{StaticResource IconEye}" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round" Width="17" Height="17" Stretch="Uniform" />
                  </Button>
                </Grid>
                <TextBlock Text="{Binding KeyEntry.Error}" IsVisible="{Binding KeyEntry.HasError}" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" Classes="small" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Classes="primary" Content="Check and save" Command="{Binding KeyEntry.SubmitCommand}" Padding="14,8"
                          ToolTip.Tip="Check the key with Anthropic, then save it, encrypted, on this PC." />
                  <Button Classes="secondary" Content="Cancel" Command="{Binding CancelChangeKeyCommand}" Padding="14,8" />
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Style -->
        <StackPanel Spacing="14">
          <TextBlock Classes="eyebrow" Text="HOW REPLIES SOUND" />
          <StackPanel Spacing="6" Background="Transparent"
                      ToolTip.Tip="How formal the replies sound. Rest the mouse on an option to see what it means.">
            <TextBlock Text="Professionalism" FontWeight="SemiBold" />
            <ListBox Classes="segmented" ItemsSource="{x:Static vm:SettingsViewModel.ProfessionalismItems}" SelectedIndex="{Binding ProfessionalismIndex}" />
          </StackPanel>
          <StackPanel Spacing="6" Background="Transparent"
                      ToolTip.Tip="How much jargon replies use and how deeply they explain things. It isn’t about length.">
            <TextBlock Text="Proficiency" FontWeight="SemiBold" />
            <ListBox Classes="segmented" ItemsSource="{x:Static vm:SettingsViewModel.ProficiencyItems}" SelectedIndex="{Binding ProficiencyIndex}" />
            <TextBlock Classes="muted small" TextWrapping="Wrap" Text="{Binding ProficiencyCaption}" />
            <TextBlock Classes="faint small" TextWrapping="Wrap" Text="How much jargon replies use and how deeply they explain things." />
          </StackPanel>
          <StackPanel Spacing="6" Background="Transparent"
                      ToolTip.Tip="The attitude of the replies. Rest the mouse on an option to see what it means.">
            <TextBlock Text="Tone" FontWeight="SemiBold" />
            <ListBox Classes="segmented" ItemsSource="{x:Static vm:SettingsViewModel.ToneItems}" SelectedIndex="{Binding ToneIndex}" />
          </StackPanel>
          <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
            <StackPanel Spacing="6" Background="Transparent"
                        ToolTip.Tip="How long each suggested reply is.">
              <TextBlock Text="Length" FontWeight="SemiBold" />
              <ListBox Classes="segmented" ItemsSource="{x:Static vm:SettingsViewModel.LengthItems}" SelectedIndex="{Binding LengthIndex}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="6" Background="Transparent"
                        ToolTip.Tip="How many alternatives you get for SAY and for TYPE.">
              <TextBlock Text="Options per section" FontWeight="SemiBold" />
              <ListBox Classes="segmented" ItemsSource="{x:Static vm:SettingsViewModel.OptionItems}" SelectedIndex="{Binding OptionsIndex}" />
            </StackPanel>
          </Grid>
          <StackPanel Spacing="6" Background="Transparent"
                      ToolTip.Tip="The language replies are written in. Leave it empty to reply in the language the other person is speaking, or type one, like “Spanish”.">
            <TextBlock Text="Reply language" FontWeight="SemiBold" />
            <TextBox Classes="field" Text="{Binding ReplyLanguage}" Watermark="Same as the other person" />
          </StackPanel>
          <StackPanel Spacing="6" Background="Transparent"
                      ToolTip.Tip="Anything Claude should know to sound like you: your role, the situation, words to avoid. It is included with every request.">
            <TextBlock Text="About me and extra instructions" FontWeight="SemiBold" />
            <TextBox Classes="field" Text="{Binding CustomInstructions}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="84"
                     Watermark="e.g. “I’m interviewing for a junior analyst role.” or “Never use the word synergy.”" />
          </StackPanel>
        </StackPanel>

        <!-- Model -->
        <StackPanel Spacing="10">
          <TextBlock Classes="eyebrow" Text="CLAUDE MODEL" />
          <ListBox Classes="choices" ItemsSource="{x:Static vm:SettingsViewModel.ModelItems}" SelectedItem="{Binding SelectedModel}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="core:ModelChoice">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                  <TextBlock Grid.Column="1" Text="{Binding Blurb}" Classes="muted small" VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <Border Classes="card"
                  ToolTip.Tip="Think before replying. On: Claude spends more effort on each reply, which is slower to start but better on hard or technical questions. Off (the default): replies begin as soon as they can.">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="2">
                <TextBlock Text="Think before replying" FontWeight="SemiBold" />
                <TextBlock Classes="muted small" TextWrapping="Wrap" Text="Slower to start, better on hard or technical questions. Off: replies begin sooner." />
              </StackPanel>
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding ThinkFirst}" OnContent="" OffContent="" Margin="12,0,-12,0" VerticalAlignment="Center" />
            </Grid>
          </Border>
        </StackPanel>

        <!-- Privacy -->
        <StackPanel Spacing="10">
          <TextBlock Classes="eyebrow" Text="PRIVACY" />
          <Border Classes="card" ToolTip.Tip="{Binding HideTip}">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="2">
                <TextBlock Text="Hide from screen sharing" FontWeight="SemiBold" />
                <TextBlock Classes="muted small" TextWrapping="Wrap"
                           Text="Keeps this app's windows out of screen shares, recordings and screenshots, so people on a call don't see them. A camera pointed at your screen still can." />
                <TextBlock Classes="small" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" IsVisible="{Binding !HideSupported}"
                           Text="Not available on this PC (needs Windows 10 version 2004 or later)." />
              </StackPanel>
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding HideFromCapture}" IsEnabled="{Binding HideSupported}" OnContent="" OffContent="" Margin="12,0,-12,0" VerticalAlignment="Center" />
            </Grid>
          </Border>
        </StackPanel>

        <!-- Listening -->
        <StackPanel Spacing="10">
          <TextBlock Classes="eyebrow" Text="LISTENING" />
          <Border Classes="card"
                  ToolTip.Tip="Include my microphone. On: your own voice is transcribed too, as “You”, so Claude knows what you have already said. Use headphones, or the mic will also pick up the other person from your speakers.">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="2">
                <TextBlock Text="Include my microphone" FontWeight="SemiBold" />
                <TextBlock Classes="muted small" TextWrapping="Wrap" Text="So Claude knows what you've already said. Use headphones, or your mic will pick up the speakers too." />
              </StackPanel>
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding UseMicrophone}" OnContent="" OffContent="" Margin="12,0,-12,0" VerticalAlignment="Center" />
            </Grid>
          </Border>
          <TextBlock Text="Speech recognition" FontWeight="SemiBold" Margin="0,6,0,0" Background="Transparent"
                     ToolTip.Tip="Which model turns speech into text on this PC. Bigger is more accurate but slower. A model downloads once, the first time it is used." />
          <ListBox Classes="choices" ItemsSource="{x:Static vm:SettingsViewModel.SpeechItems}" SelectedItem="{Binding SelectedSpeech}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:SpeechChoice">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" MinWidth="64" />
                  <TextBlock Grid.Column="1" Text="{Binding Blurb}" Classes="muted small" VerticalAlignment="Center" TextWrapping="Wrap" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Classes="faint small" TextWrapping="Wrap" Text="Speech is recognised on this PC. The model downloads once; changing it later downloads the new one." />
        </StackPanel>

      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
