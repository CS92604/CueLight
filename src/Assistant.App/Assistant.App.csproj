<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <RootNamespace>Assistant.App</RootNamespace>
    <AssemblyName>ClaudeLiveAssistant</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>1.0.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.31" />
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
    <!-- For CPUs without AVX2 (older and some low-end PCs): Whisper.net picks this one automatically. -->
    <PackageReference Include="Whisper.net.Runtime.NoAvx" Version="1.9.1" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Assistant.App.Tests" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Assistant.Core\Assistant.Core.csproj" />
  </ItemGroup>

  <!-- Keep the Windows download lean: the speech runtime ships native libraries for every OS.
       Only the 64-bit Windows ones stay: the normal build (runtimes/win-x64) and the one for CPUs
       without AVX2 (runtimes/noavx/win-x64). -->
  <Target Name="PruneForeignRuntimes" AfterTargets="Publish" Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <ItemGroup>
      <ForeignRuntime Include="$([System.IO.Directory]::GetDirectories('$(PublishDir)runtimes'))" />
      <ForeignRuntime Remove="@(ForeignRuntime)" Condition="'%(Filename)%(Extension)' == 'win-x64' Or '%(Filename)%(Extension)' == 'noavx'" />
      <ForeignRuntime Include="$([System.IO.Directory]::GetDirectories('$(PublishDir)runtimes/noavx'))" Condition="Exists('$(PublishDir)runtimes/noavx')" />
      <ForeignRuntime Remove="@(ForeignRuntime)" Condition="'%(Filename)%(Extension)' == 'win-x64' And $([System.String]::Copy('%(FullPath)').Contains('noavx'))" />
    </ItemGroup>
    <RemoveDir Directories="@(ForeignRuntime)" />
  </Target>
</Project>
